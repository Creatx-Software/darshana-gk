# Environment Configuration Example
# Copy this file to .env.local for local development

# --- Required ---

# Strapi CMS origin (read by lib/api/config.ts).
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Public origin of the site. Canonical URLs, Open Graph tags, the sitemap and
# robots.txt are all built from this. In production it must match the live
# domain exactly, with no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SEO (optional) ---

# Search Console / Bing Webmaster ownership tokens. Blank values are omitted
# from the HTML, so it is safe to leave these empty until the properties are
# claimed. Everything else about SEO lives in lib/seo/config.ts.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Reference only ---
# The values below are not read by the app; the canonical source for business
# details is lib/seo/config.ts, with Strapi Site Settings overriding at runtime.

NEXT_PUBLIC_SITE_NAME="Darshana Gal Ketayam"
NEXT_PUBLIC_COMPANY_EMAIL=darshandgk@gmail.com
NEXT_PUBLIC_COMPANY_PHONE="+94 33 222 3714"
NEXT_PUBLIC_COMPANY_ADDRESS="No. 263/1, Kandy Road, Miriswatta, Mudungoda, Gampaha, Sri Lanka"
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/DGK.SL
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/dgk.sl

# Analytics (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Form Submission (Optional - for future email service integration)
# EMAIL_SERVICE_API_KEY=
# EMAIL_SERVICE_ENDPOINT=
