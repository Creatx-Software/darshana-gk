# Strapi CMS origin. This is the variable the app actually reads
# (lib/api/config.ts) — NEXT_PUBLIC_API_URL is not used anywhere.
NEXT_PUBLIC_STRAPI_URL=https://api.darshanagalketayam.lk

# Public origin of the site. Canonical URLs, Open Graph tags, the sitemap and
# robots.txt are all built from this, so it must match the live domain
# exactly (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://darshanagalketayam.lk

# Search Console / Bing Webmaster ownership tokens.
# Leave blank until the properties are claimed — blank values are omitted from
# the HTML rather than emitted empty.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Node Environment
NODE_ENV=production
